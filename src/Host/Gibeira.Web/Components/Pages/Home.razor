@page "/"
@rendermode InteractiveServer
@inject ILedgerStore Store
@inject TimeProvider Time

<PageTitle>Gibeira</PageTitle>

@* The top bar, the period bar and the twelve months of the period side by side (HOME-01). *@
<div class="home">
    <TopBar OnAdd="() => OpenModal(Kind.Income, today)" />
    <PeriodBar @bind-Period="period" Today="today" />
    <main class="ledger" aria-label="saldos">
        @foreach (var month in Store.Months(period))
        {
            <MonthTable @key="month.Month" Ledger="month" OnCell="OpenDrawer" />
        }
    </main>
    @if (drawerOpen)
    {
        <DayDrawer @bind-Day="drawerDay" @bind-Filter="drawerFilter" Revision="revision" OnClose="() => drawerOpen = false"
                   OnAdd="() => OpenModal(drawerFilter ?? Kind.Income, drawerDay)" OnRemove="Remove" />
    }
    @if (form is not null)
    {
        <AddItemModal Form="form" OnAdd="Add" OnClose="() => form = null" />
    }
</div>

@code {
    private DateOnly today;
    private Period period = null!;
    private bool drawerOpen;
    private DateOnly drawerDay;
    private Kind? drawerFilter;
    private AddItemForm? form;
    private int revision;

    protected override void OnInitialized()
    {
        today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
        period = Period.Starting(today);
    }

    // A money cell filters by its kind, a dia cell shows todos (DAY-01, DAY-02).
    private void OpenDrawer((DateOnly Date, Kind? Kind) cell)
    {
        drawerDay = cell.Date;
        drawerFilter = cell.Kind;
        drawerOpen = true;
    }

    // The top bar opens it on entrada and today (HOME-18); the drawer's + on its day and filter, entrada for todos (DAY-10).
    private void OpenModal(Kind kind, DateOnly date) => form = new AddItemForm(kind, date);

    // The tables and an open drawer re-read the store on render (ADD-21).
    private void Add(NewItem item)
    {
        Store.Add(item);
        revision++;
        form = null;
    }

    // That occurrence only; the tables re-read the store on render (DAY-12).
    private void Remove(DayEntry entry)
    {
        Store.Remove(entry.ItemId, entry.Date);
        revision++;
    }
}
