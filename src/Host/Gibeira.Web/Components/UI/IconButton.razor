@* A round, icon-only button; Label is its pt-BR accessible name (UI-06). Bare drops the border and the ground,
   as the canvas draws the modal's X. *@
<button type="button" class="@(Bare ? "icon-button icon-button--bare" : "icon-button")" aria-label="@Label" disabled="@Disabled" @onclick="Click">
    <Icon Name="Icon" Size="@(Bare ? 20 : 18)" />
</button>

@code {
    [Parameter, EditorRequired]
    public IconName Icon { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Bare { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException($"{nameof(IconButton)} needs a {nameof(Label)}: it is the button's only name for a screen reader.");
        }
    }

    private Task Click() => Disabled ? Task.CompletedTask : OnClick.InvokeAsync();
}
